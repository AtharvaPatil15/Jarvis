{
  "name": "jarvis-assistant-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "next dev ./apps/web",
    "build": "npm run build:web",
    "build:web": "next build ./apps/web",
    "start": "npm run start:web",
    "start:web": "next start ./apps/web",
    "lint": "npm run lint:web",
    "lint:web": "next lint ./apps/web",
    "desktop": "electron ./apps/desktop/main.js",
    "dev:backend": "python apps/backend/run_server.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.31.0",
    "leva": "^0.10.1",
    "next": "^15.1.6",
    "postprocessing": "^6.38.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^40.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.51",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
