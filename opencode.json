{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/PLAN.md"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "deny",
    "doom_loop": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push origin main*": "deny",
      "git push origin Test*": "deny",
      "git push origin :*": "deny",
      "git push --delete*": "deny",
      "git checkout main*": "deny",
      "git checkout Test*": "deny",
      "git switch main*": "deny",
      "git switch Test*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "gh repo delete*": "deny",
      "gh pr merge*": "deny",
      "ollama rm*": "deny",
      "Stop-Process -Name*": "deny",
      "taskkill /IM*": "deny",
      "taskkill /F /IM*": "deny"
    }
  }
}
